OPENAI_API_KEY=
OPENAI_BASE_URL=
# Generation uses generate.py --model; the model settings below are evaluation-only.
# Evaluation executor: resolve click/input targets and infer keys.
OPENAI_MODEL_NAME=gemini-2.5-pro
# Evaluation judge: high-level visual similarity.
MODEL_FOR_EVAL=gemini-2.5-pro
# Logical assertion judge (falls back to MODEL_FOR_EVAL if unset or empty).
MODEL_FOR_ASSERTION_EVAL=gpt-6-luna
HEADLESS=true # set to false if you want to see the browser
