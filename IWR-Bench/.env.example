OPENAI_API_KEY=
OPENAI_BASE_URL=
# Generation uses generate.py --model; these two settings are evaluation-only.
# Evaluation executor: resolve click/input targets and infer keys.
OPENAI_MODEL_NAME=gemini-2.5-pro
# Evaluation judge: logical assertions and high-level visual similarity.
MODEL_FOR_EVAL=gemini-2.5-pro
HEADLESS=true # set to false if you want to see the browser
