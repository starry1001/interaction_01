mentById('draftBack').onclick=()=>{draftView.style.display='none';composer.style.display='block';modal.classList.remove('draftview')};\ndocument.getElementById('pollTool').onclick=()=>{pollBox.style.display=pollBox.style.display==='none'?'block':'none';picker.style.display='none';modal.classList.toggle('pollmodal',pollBox.style.display==='block');updatePost()};\ndocument.getElementById('removePoll').onclick=()=>{pollBox.style.display='none';modal.classList.remove('pollmodal');updatePost()};\ndocument.getElementById('emojiTool').onclick=()=>{picker.style.display=picker.style.display==='none'?'block':'none'};\nconst emojiSet=['😀','😃','😄','😁','😆','😅','🤣','😂','🙂','🙃','😉','😊','😍','🥰','😘','😗','😙','😚','😋','😛','😜','🤪','😝','🤑','🤗','🤭','🤫','🤔','🤐','🤨','😐','😑','😶','😏','😒','🙄','😬','🤥','😌','😔','😪','🤤','😴','😷','🤒','🤕','🤢','🤮','🥵','🥶','🥴','😵','🤯','🤠','🥳','😎','🤓','🧐','😕','😟','🙁','☹️','😮','😯','😲','😳','🥺','😭','😤','😠','😡','🤬','💀','👋','👍','❤️','🎉'];\nconst grid=document.getElementById('emojiGrid');\nemojiSet.forEach((emo,i)=>{const span=document.createElement('span');span.className='emoji-cell btn';span.textContent=emo;span.onclick=()=>{input.focus();document.execCommand('insertText',false,emo);document.getElementById('emojiDescription').textContent=emo;updatePost()};grid.appendChild(span)});\ninput.addEventListener('input',updatePost);\nfunction updatePost(){const hasText=input.innerText.trim().length>0;let hasPoll=false;if(pollBox.style.display!=='none'){hasPoll=[...pollBox.querySelectorAll('input')].some(i=>i.value.trim())}postBtn.classList.toggle('disabled',!hasText&&!hasPoll)}\ndocument.getElementById('addOption').onclick=()=>{const options=document.getElementById('pollOptions');let count=options.querySelectorAll('.poll-option').length;if(count>=4)return;const wrap=document.createElement('div');wrap.className='poll-option';wrap.innerHTML='<label>Choice '+(count+1)+'</label><span class=\"count\">0 / 25</span><input maxlength=\"25\" aria-label=\"Choice '+(count+1)+'\">';options.appendChild(wrap);const inp=wrap.querySelector('input');inp.addEventListener('input',()=>{wrap.querySelector('.count').textContent=inp.value.length+' / 25';updatePost()});inp.focus()};\ndocument.querySelectorAll('.poll-option input').forEach(i=>i.addEventListener('input',()=>{i.parentElement.querySelector('.count').textContent=i.value.length+' / 25';updatePost()}));\npostBtn.onclick=()=>{if(postBtn.classList.contains('disabled'))return;overlay.classList.remove('open');picker.style.display='none';input.innerHTML='';document.querySelectorAll('.poll-option input').forEach(i=>i.value='');pollBox.style.display='none';modal.classList.remove('pollmodal');updatePost();const t=document.getElementById('toast');t.style.display='block';setTimeout(()=>t.style.display='none',1800)};\ndocument.getElementById('quickEmoji').onclick=openModal;\ndocument.addEventListener('keydown',e=>{if(e.key==='Escape'){overlay.classList.remove('open');picker.style.display='none'}});\n</script>\n</body>\n</html>\n```",
